<Window x:Class="WinBootVideo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinBootVideo · 登录动画 (0.1.3)" Width="1100" Height="810" MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#F5F7FA" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Grid Background="#F5F7FA">
    <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#ECF1F7" BorderBrush="#DFE5ED" BorderThickness="0,0,1,0">
      <Grid Margin="22,32,18,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Border Width="42" Height="42" CornerRadius="10" Background="#146CC4" HorizontalAlignment="Left"><TextBlock Text="WV" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="WinBootVideo" FontSize="18" FontWeight="SemiBold" Margin="0,15,0,5"/>
          <TextBlock Text="让登录多一点仪式感" Style="{StaticResource Small}"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="-8,34,-4,0" Background="#DCE9F7" CornerRadius="6" Padding="13,12"><TextBlock Text="▶  登录动画" Foreground="#105EA8" FontWeight="SemiBold"/></Border>
        <StackPanel Grid.Row="3">
          <TextBlock Text="WINDOWS 11" FontSize="11" FontWeight="SemiBold" Foreground="#657487"/>
          <TextBlock Text="个人使用初版 0.1.3" Style="{StaticResource Small}" Margin="0,4,0,16"/>
          <Button Content="视频要求与恢复说明" Click="HelpClick" Padding="8,9" FontSize="11"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,26,28,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <StackPanel><TextBlock Text="登录动画" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="输入密码 / PIN 后播放，每次登录一次，解锁不重复。" Style="{StaticResource Small}" Margin="0,8,160,0"/></StackPanel>
        <Border Background="#E7EDF4" CornerRadius="12" Padding="12,6" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,0,0"><TextBlock x:Name="StartupBadge" Text="尚未启用" FontSize="12"/></Border>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="Editor">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="01  选择视频" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <Border Background="#152236" CornerRadius="8" Height="120" Margin="0,0,0,14">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14">
                    <TextBlock Text="▷" FontSize="35" Foreground="#BED6F3" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FileNameText" Text="把视频拖到这里，或点击选择" Foreground="White" TextAlignment="Center" Margin="0,10,0,6" FontWeight="SemiBold"/>
                    <TextBlock Text="MP4 · H.264 · SDR · 推荐 5–15 秒" FontSize="11" Foreground="#AEBED2" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="FilePathText" Text="尚未选择视频" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" MaxHeight="42" Margin="0,0,0,12"/>
                <WrapPanel><Button Content="选择视频…" Click="ChooseClick" Margin="0,0,8,0"/><Button Content="检查视频" Click="ProbeClick"/></WrapPanel>
                <TextBlock x:Name="MetadataText" Text="检查格式后，使用全屏预览确认实际播放效果。" Style="{StaticResource Small}" Margin="0,13,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="02  兼容处理（可选）" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <TextBlock Text="生成 1080p / 30 fps MP4，保留比例并加黑边。HDR 转为 SDR；原视频保留。" Style="{StaticResource Small}"/>
                <Grid Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="保留前" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="TrimSeconds" Text="15" Grid.Column="1"/><TextBlock Text="秒" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,14,0"/><CheckBox x:Name="MuteConversion" Content="移除音轨" Grid.Column="3" VerticalAlignment="Center" Margin="0"/>
                </Grid>
                <WrapPanel><Button Content="转换并选用…" Click="ConvertClick" Margin="0,0,8,0"/><Button Content="选择 FFmpeg…" Click="ToolClick" Padding="10,9"/></WrapPanel>
                <TextBlock x:Name="ToolsText" Style="{StaticResource Small}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="播放设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>
                <TextBlock Text="播放屏幕" Style="{StaticResource Label}"/><ComboBox x:Name="ScreenChoice" DisplayMemberPath="Label" SelectedValuePath="Device"/>
                <CheckBox x:Name="CoverOthers" Content="播放时遮住其他屏幕" IsChecked="True" Margin="0,12,0,20"/>
                <Grid><TextBlock Text="音量" Style="{StaticResource Label}"/><TextBlock Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="#657487"/></Grid>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="35" TickFrequency="5" Margin="0,5,0,18"/>
                <TextBlock Text="退出淡出（毫秒）" Style="{StaticResource Label}"/><TextBox x:Name="FadeText" Text="650" Margin="0,0,0,16"/>
                <TextBlock Text="播放等待上限（秒）" Style="{StaticResource Label}"/><TextBox x:Name="MaximumText" Text="45"/>
                <TextBlock Text="桌面可见后计时，包括加载、播放及淡出。输入密码的时间不计入。" Style="{StaticResource Small}" Margin="0,7,0,18"/>
                <TextBlock Text="视频加载等待（秒）" Style="{StaticResource Label}"/><TextBox x:Name="StartupText" Text="8"/>
                <TextBlock Text="加载超时后进入桌面。播放器冷启动另有 30 秒上限，输入密码的时间不计入。" Style="{StaticResource Small}" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="#EAF2FC" CornerRadius="8" Padding="15" Margin="0,16,0,0">
              <TextBlock Text="预览中按 Esc 或空格跳过。&#10;动画结束后淡出到桌面。&#10;&#10;选择和转换不会更改登录配置。成功预览后才可以启用。" Foreground="#35577C" FontSize="12" LineHeight="21"/>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" Background="White" BorderBrush="#DFE5ED" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,16,0,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="StatusText" Text="选择一个视频，开始设置你的登录动画。" FontSize="12"/><ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,9,10,0"/></StackPanel>
          <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="CancelClick" Visibility="Collapsed" Padding="12,5" MinHeight="28" Margin="8,0,0,0"/>
        </Grid>
      </Border>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <WrapPanel x:Name="ActionButtons"><Button x:Name="PreviewButton" Content="03  保存并全屏预览" Click="PreviewClick" Margin="0,0,9,0"/><Button x:Name="EnableButton" Content="04  启用登录动画" Style="{StaticResource PrimaryButton}" Click="EnableClick" ToolTip="成功预览后才能启用；无需管理员权限。" ToolTipService.ShowOnDisabled="True"/></WrapPanel>
        <Button x:Name="RestoreButton" Grid.Column="1" Content="恢复普通登录" Click="RestoreClick" Margin="12,0,0,0"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
