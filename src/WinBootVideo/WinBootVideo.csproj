<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.3.0</Version>
    <Authors>0x3fffff</Authors>
    <Company>0x3fffff</Company>
    <Product>WinBootVideo</Product>
    <Description>Windows 11 开机 Logo 与登录动画工具</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/WinBootVideo.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup><Compile Include="../Shared/WindowsCommandLine.cs" Link="Core/WindowsCommandLine.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/InputDesktopState.cs" Link="Core/InputDesktopState.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/StartupLimits.cs" Link="Core/StartupLimits.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/LoginTaskSupport.cs" Link="Core/LoginTaskSupport.cs" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../assets/HackBGRT-2.6.0.zip" LogicalName="WinBootVideo.HackBGRT.zip" /></ItemGroup>
  <ItemGroup><Resource Include="../../assets/WinBootVideo.ico" Link="Assets/App.ico" /></ItemGroup>
</Project>
