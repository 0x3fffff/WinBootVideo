<Window x:Class="WinBootVideo.BootLogoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinBootVideo · 开机 Logo" Width="1040" Height="800" MinWidth="940" MinHeight="700" WindowStartupLocation="CenterOwner" Background="#F5F7FA">
  <Grid Margin="28,24" Background="#F5F7FA">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="开机 Logo" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="替换 Windows 加载时的静态 Logo（包括厂商 Logo） · 刚通电时的固件 Logo 可能仍短暂出现" Style="{StaticResource Small}" Margin="0,8,0,0"/>
    </StackPanel>
    <ScrollViewer x:Name="LogoScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="01  选择与转换图片" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <Border Background="Black" Height="190" CornerRadius="8" ClipToBounds="True"><Grid>
                <Image x:Name="LogoPreview" Width="320" Height="180" Stretch="Uniform"/>
                <TextBlock x:Name="PreviewPlaceholder" Text="静态 Logo 预览" Foreground="#9AAFC8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid></Border>
              <TextBlock Text="示意预览。固件分辨率可能低于桌面；原比例缩放，透明区域铺黑。" Style="{StaticResource Small}" Margin="0,9,0,12"/>
              <TextBlock x:Name="ImagePathText" Text="尚未选择图片" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,12"/>
              <WrapPanel><Button x:Name="ChooseImageButton" Content="选择图片…" Click="ChooseImageClick" Margin="0,0,8,8"/>
                <ComboBox x:Name="CanvasChoice" Width="155" SelectedIndex="0" SelectionChanged="CanvasChanged" Margin="0,0,8,8"><ComboBoxItem Content="320 × 180（推荐）"/><ComboBoxItem Content="256 × 256"/><ComboBoxItem Content="400 × 240"/><ComboBoxItem Content="600 × 360"/></ComboBox>
              </WrapPanel>
              <TextBlock Text="静态 PNG / JPEG / BMP，最大 16 MB、2000 万像素。输出 24 位未压缩 BMP3（54 字节头）。" Style="{StaticResource Small}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
            <TextBlock Text="02  检查电脑" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock x:Name="HardwareText" Text="尚未进行管理员只读检查。未知状态会阻止安装。" Style="{StaticResource Small}" Margin="0,0,0,12"/>
            <WrapPanel><Button x:Name="ProbeButton" Content="管理员只读检查（UAC）" Click="ProbeClick" Margin="0,0,8,0"/>
              <Button x:Name="FirmwareDetailsButton" Content="启动项详情" Click="FirmwareDetailsClick" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock Text="额外启动项可能是 USB、网络或厂商功能，也可能是其他系统；名称不能作为安全依据。检查后可在详情中查看，不要删除它们绕过检查。" Style="{StaticResource Small}" Margin="0,10,0,0"/>
            <TextBlock Text="支持当前 UEFI x64、单 Windows 启动项、单 EFI 系统分区且系统盘未加密；允许完整核验后的 Insyde 通用 USB / 光驱 / 网络入口并原样保留。加密、多分区、其他系统或未知配置仍阻止安装。" Style="{StaticResource Small}" Margin="0,10,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
            <TextBlock Text="03  准备与确认" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="先导出图片、配置、官方工具和恢复说明到独立文件夹。导出可在不符合安装条件的电脑上使用；导出不会更改启动设置。" Style="{StaticResource Small}"/>
            <Button x:Name="ExportButton" Content="导出准备包…" Click="ExportClick" HorizontalAlignment="Left" Margin="0,12,0,10" IsEnabled="False"/>
            <CheckBox x:Name="RescueCheck" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged"><TextBlock Text="已准备可启动的恢复 U 盘，确认帐户密码可用，恢复说明已保存到另一设备" TextWrapping="Wrap"/></CheckBox>
            <CheckBox x:Name="TrialCheck" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged"><TextBlock Text="了解先从启动菜单单次试启动；成功后再手动设为默认" TextWrapping="Wrap"/></CheckBox>
            <CheckBox x:Name="ShimCheck" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged"><TextBlock Text="已阅读首次 Secure Boot / shim 哈希确认步骤" TextWrapping="Wrap"/></CheckBox>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="BIOS / UEFI 引导" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <TextBlock Text="保持现有 UEFI、CSM、SATA 设置。不要切换启动模式、清空 TPM 或 Secure Boot 密钥。" Style="{StaticResource Small}" Margin="0,0,0,12"/>
            <TextBlock Text="安装后先用电脑官方手册中的启动菜单键，单次选择 HackBGRT。Windows Boot Manager 仍是默认。" Style="{StaticResource Small}" Margin="0,0,0,12"/>
            <TextBlock Text="Secure Boot 开启时保留它。首次试启动按 shim.md 选择 Enroll hash from disk → EFI → HackBGRT → grubx64.efi。若固件拒绝 shim，返回 Windows Boot Manager 并停止。" Style="{StaticResource Small}" Margin="0,0,0,12"/>
            <TextBlock Text="单次验证成功后，再手动将 HackBGRT 放到 Boot Priority 第一位。不要使用覆盖 Windows 启动器的方式。" Style="{StaticResource Small}" Margin="0,0,0,12"/>
            <Button Content="查看完整引导与恢复说明" Click="GuideClick" Padding="8,9"/>
            <Button Content="HackBGRT 官方 shim 指引 ↗" Click="ShimGuideClick" Padding="8,9" Margin="0,10,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
            <TextBlock Text="可恢复的安装" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="官方 HackBGRT 2.6.0 发布包已固定 SHA-256。只安装独立 EFI 文件；本软件核验后将新启动项追加到末尾，不覆盖 Windows 启动器。" Style="{StaticResource Small}"/>
            <TextBlock Text="若试启动失败：用固件启动菜单选择 Windows Boot Manager，进入 Windows 后恢复原 Logo。保留恢复 U 盘。" Style="{StaticResource Small}" Margin="0,12,0,0"/>
            <TextBlock Text="固件差异与断电风险无法完全消除。此初版尚无真实 / 虚拟 UEFI 首次启动验收，必须先单次试启动。" Style="{StaticResource Small}" Margin="0,12,0,0"/>
          </StackPanel></Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" Background="White" BorderBrush="#D5DFE8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,12">
      <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="LogoStatus" Text="先选图片、导出准备包，再完成只读检查和恢复确认。" MaxHeight="78" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
        <Button Grid.Column="1" Content="操作详情" Click="DetailsClick" Padding="10,5" MinHeight="30" VerticalAlignment="Center"/>
        </Grid>
        <ProgressBar x:Name="LogoBusy" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="3">
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="InstallHint" Style="{StaticResource Small}" MaxHeight="58" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
        <Button Grid.Column="1" Content="查看安装条件" Click="RequirementsClick" Padding="10,5" MinHeight="30" VerticalAlignment="Center"/>
      </Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="InstallLogoButton" Content="04  安装独立 Logo（UAC）" Style="{StaticResource PrimaryButton}" Click="InstallClick" HorizontalAlignment="Left" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
        <Button x:Name="RestoreLogoButton" Grid.Column="1" Content="恢复原 Logo（UAC）" Click="RestoreClick" IsEnabled="False"/>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
